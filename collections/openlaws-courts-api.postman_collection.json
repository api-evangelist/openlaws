          "request": {
            "name": "Get Courts by Jurisdiction",
            "description": {
              "content": "Lists all the active and inactive courts for a Jurisdiction. Note that federal bankruptcy courts are separate from federal courts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "jurisdictions",
                ":jurisdiction_key",
                "courts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "jurisdiction_key",
                  "description": "(Required) Two to three letter Jurisdiction Key. `FED` for federal and generally, the postal abbreviation for most U.S. states and territories."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
